# Copy to .env (never commit .env).

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/cleads

# Auth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Transactional email (Resend). Cold outreach must NOT use it.
RESEND_API_KEY=
RESEND_FROM_EMAIL=contact@cleads.fr
RESEND_DOMAIN=cleads.fr

# Transactional email providers (docs/crm-v1/ENVOI-EMAILS.md). Amazon SES is the default when its keys are set, Resend is the fallback.
# Explicit names: Netlify reserves AWS_ACCESS_KEY_ID and its siblings. Use the access key of the restricted IAM user, never a root key.
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
SES_REGION=eu-north-1
# Bounces and complaints: the SES configuration set and the only SNS topic the webhook (/api/webhooks/ses) accepts.
SES_CONFIGURATION_SET=
SES_SNS_TOPIC_ARN=
# Optional: sender (default contact@cleads.fr) and a forced default provider (ses | resend).
# MAIL_FROM=contact@cleads.fr
# MAIL_PROVIDER=ses

# Telephony (E32, docs/crm-v1/TELEPHONIE-ZADARMA.md): the API keys of the Zadarma account (Settings › API). The secret also
# signs the call notifications (/api/webhooks/zadarma). Optional: the account's time zone when it is not Europe/Paris.
ZADARMA_API_KEY=
ZADARMA_API_SECRET=
# ZADARMA_TIMEZONE=Europe/Paris

# Avatars (S3). Server-side only: no NEXT_PUBLIC_ prefix, ever.
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=

# Realtime notifications (Pusher)
NEXT_PUBLIC_PUSHER_APP_ID=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=
PUSHER_SECRET=

# Bearer secret of the hourly meeting-reminder cron (POST /api/cron/meeting-reminders)
CRON_SECRET=
# Signs the "change or cancel my meeting" links; falls back to NEXTAUTH_SECRET when empty
MEETING_LINK_SECRET=

# Local only: set to 1 to browse /app/design without signing in (ignored in production).
# CRM_DESIGN_PREVIEW=1

# Cleads Extractor (company search). Server-side only: the key never reaches the browser.
EXTRACTOR_URL=https://your-extractor-host
EXTRACTOR_API_KEY=            # the "crm" key of the extractor (API_KEYS=admin:...,crm:...)
# Optional: completion notifications. Same value as WEBHOOK_SECRET on the extractor; the callback must be public https.
EXTRACTOR_WEBHOOK_SECRET=
# EXTRACTOR_WEBHOOK_BASE_URL=https://crm.example.com   # defaults to NEXT_PUBLIC_APP_URL

# Prospecting mailboxes (docs/crm-v1/EMAILING.md). Seals mailbox passwords in the database: openssl rand -base64 32.
# Never change it once mailboxes are saved (their passwords would no longer open).
MAILBOX_SECRET_KEY=
# Optional: signs unsubscribe links (defaults to NEXTAUTH_SECRET), serves them from a prospecting domain instead of the CRM's
# address, and lists the domains a mailbox may never use (default cleads.fr).
# OUTREACH_LINK_SECRET=
# OUTREACH_LINK_BASE_URL=https://trycleads.com
# OUTREACH_PROTECTED_DOMAINS=cleads.fr

# AI agents (docs/crm-v1/AGENTS-IA.md). Vercel AI Gateway key, server-side only: one key for every model provider.
# Without it the AI features say they are unavailable; spending caps are set in Réglages › IA.
AI_GATEWAY_API_KEY=
# Prospect audits (E20) run in the AI worker: its worker.env needs this free Google PageSpeed Insights key, not the site.
# GOOGLE_PAGESPEED_API_KEY=
# Studio Web (E23): the host previews are served on (a domain alias of this site; apercu.cleads.fr in production by
# default, none in development, where previews live under /apercu), and the secret preview links are derived from
# (optional, 32 characters or more; derived from NEXTAUTH_SECRET otherwise: changing it changes every link).
# STUDIO_PREVIEW_HOST=apercu.cleads.fr
# STUDIO_PREVIEW_SECRET=

# ---------------------------------------------------------------------------------------------------------------------
# Production on Vercel (docs/crm-v1/MIGRATION-VERCEL.md): the values the code uses when these are absent, written out.
# Set them on Vercel (Production) only if the value must differ; leave them commented in a local .env (in development
# STUDIO_PREVIEW_HOST must stay empty, so that previews are served under /apercu).
# OUTREACH_LINK_SECRET=        # empty: signed with NEXTAUTH_SECRET, as on Netlify. Copy Netlify's value if it had one.
# MEETING_LINK_SECRET=         # same rule: empty means NEXTAUTH_SECRET; never change it once links are sent.
# STUDIO_PREVIEW_HOST=apercu.cleads.fr
# EXTRACTOR_MCP_URL=https://your-extractor-host/mcp   # default: EXTRACTOR_URL + /mcp
# OUTREACH_PROTECTED_DOMAINS=cleads.fr
# MAIL_FROM=contact@cleads.fr  # default: RESEND_FROM_EMAIL, then contact@cleads.fr
# MAIL_PROVIDER=               # empty: chosen in Réglages › Emails (ses | resend to force one)
