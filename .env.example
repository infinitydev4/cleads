# Copy to .env (never commit .env).

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/cleads

# Auth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Transactional email (Resend). Cold outreach must NOT use it.
RESEND_API_KEY=
RESEND_FROM_EMAIL=contact@cleads.fr
RESEND_DOMAIN=cleads.fr

# Avatars (S3). Server-side only: no NEXT_PUBLIC_ prefix, ever.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=

# Realtime notifications (Pusher)
NEXT_PUBLIC_PUSHER_APP_ID=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=
PUSHER_SECRET=

# Bearer secret of the appointment-reminder cron
CRON_SECRET=
