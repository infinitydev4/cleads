  pexelsApiKey            String?
  stableDiffusionApiKey   String?
  huggingFaceModel        String?
  huggingFaceTextModel    String?
  replicateApiKey         String?
  replicateModel          String?
  textProvider            String   @default("openai")
  allowRsslessGeneration  Boolean  @default(false)
  defaultRssCategory      String   @default("technology")
  highQualityGeneration   Boolean  @default(false)
  rssArticleSelectionMode String   @default("recent")
  rssSourceCount          Int      @default(3)
  validatedRssFeeds       String?
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

