/// LEGACY (blog, AI keys, NextAuth adapter): unused, dropped by prisma/pending/drop-legacy-blog.sql once a dump is taken.
model ArticleSchedule {
  id                      String            @id @default(cuid())
  name                    String
  userId                  String
  frequency               ScheduleFrequency @default(WEEKLY)
