enum Role {
  // Legacy: USER = former appointment "client" (becomes a Contact in E3), ADMIN = migrated to OWNER.
  USER
  ADMIN
  // CRM staff roles (docs/crm-v1/PLAN.md section 4).
  OWNER
  MANAGER
  SDR
  CLOSER
  VIEWER
}

enum AuditActorKind {
  USER
  AGENT
  SYSTEM
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum AppointmentType {
  LANDING_PAGE
  ECOMMERCE
  SAAS
  OTHER
  CONSULTATION
  SUIVI
  URGENCE
}

enum DocumentStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  ACCEPTED
  REJECTED
}

enum DocumentType {
  INVOICE
  QUOTE
}

enum SharedDocumentType {
  FILE
  IMAGE
  PDF
  OTHER
}

enum SharedBy {
  ADMIN
  USER
}

enum ScheduleStatus {
  ACTIVE
  PAUSED
  COMPLETED
  FAILED
}

enum ScheduleFrequency {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
}

/// One-time link that gives a person access to the CRM with a given role. Only the SHA-256 of the token is stored.
model Invitation {
  id          String    @id @default(cuid())
  email       String
  role        Role
  tokenHash   String    @unique
  invitedById String
  invitedBy   User      @relation(fields: [invitedById], references: [id], onDelete: Cascade)
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([email])
}

/// Who did what, when. Written by people, agents and the system; never updated.
model AuditLog {
  id          String         @id @default(cuid())
  actorId     String?
  actor       User?          @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorKind   AuditActorKind @default(USER)
  workspaceId String?
  workspace   Workspace?     @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  action      String
  entityType  String?
  entityId    String?
  /// Email or other identifier the action is about when there is no entity (failed sign-in, invitation).
  subject     String?
  metadata    Json?
  ip          String?
  createdAt   DateTime       @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@index([action, subject, createdAt])
}

// ============================================================================================
// CRM data model (docs/crm-v1/PLAN.md section 5). Every record belongs to a workspace; V1 runs a
// single one. Dates are UTC. Rules Prisma cannot express (CHECK constraints) live in the migration.
// ============================================================================================

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  users                  User[]
  invitations            Invitation[]
  auditLogs              AuditLog[]
  companies              Company[]
  contacts               Contact[]
  leads                  Lead[]
  deals                  Deal[]
  activities             Activity[]
  tasks                  Task[]
  meetings               Meeting[]
  availabilityRules      AvailabilityRule[]
  availabilityExceptions AvailabilityException[]
  importBatches          ImportBatch[]
  suppressions           Suppression[]
  savedViews             SavedView[]
  extractionSearches     ExtractionSearch[]
  bookingProfiles        BookingProfile[]
  mailSetting            MailSetting?
  mailboxes              Mailbox[]
  emailTemplates         EmailTemplate[]
  emailMessages          EmailMessage[]
  sequences              Sequence[]
  sequenceEnrollments    SequenceEnrollment[]
  campaigns              Campaign[]
  aiSetting              AiSetting?
  aiUsage                AiUsage[]
  agentRuns              AgentRun[]
  agentApprovals         AgentApproval[]
  agentDefinitions       AgentDefinition[]
  skills                 Skill[]
  agentSkills            AgentSkill[]
  offers                 Offer[]
  prospectAudits         ProspectAudit[]
  offerPitches           OfferPitch[]
  offerRecommendations   OfferRecommendation[]
  emailDrafts            EmailDraft[]
  replyTriages           ReplyTriage[]
  generatedSites         GeneratedSite[]
  aiConversations        AiConversation[]
  strategyProposals      StrategyProposal[]
  leadRelevances         LeadRelevance[]
  aiEvaluations          AiEvaluation[]
  agentMissions          AgentMission[]
  agentMissionSchedules  AgentMissionSchedule[]
}

enum LeadSource {
  EXTRACTOR
  CSV
  INBOUND
  MANUAL
  LEGACY
}

enum EmailKind {
  NOMINATIVE
  GENERIC
  UNKNOWN
}

enum LeadStatus {
  NEW
  CONTACTED
  REPLIED
  QUALIFIED
  DISQUALIFIED
  DO_NOT_CONTACT
}

enum DealStage {
  QUALIFIED
  MEETING_SET
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum ActivityKind {
  NOTE
  CALL
  EMAIL
  MEETING
  STATUS_CHANGE
  SYSTEM
  /// A task created, done, postponed or dropped.
  TASK
}

enum MeetingType {
  DISCOVERY
  DEMO
  FOLLOW_UP
}

enum MeetingStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  NO_SHOW
  CANCELED
  RESCHEDULED
}

enum MeetingOutcome {
  QUALIFIED
  FOLLOW_UP
  LOST
}

enum ImportStatus {
  RUNNING
  DONE
  FAILED
}

enum SuppressionReason {
  UNSUBSCRIBED
  BOUNCED
  COMPLAINED
  MANUAL
}

enum SavedViewEntity {
  LEAD
  DEAL
  MEETING
}

/// A business. `externalId` is the stable identifier given by the source (Cleads Extractor) and makes imports replayable.
model Company {
  id             String     @id @default(cuid())
  workspaceId    String
  workspace      Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name           String
  /// Lower-case host without "www.", the second deduplication key after externalId.
  domain         String?
  website        String?
  phone          String?
  email          String?
  address        String?
  city           String?
  postalCode     String?
  country        String     @default("FR")
  sector         String?
  siret          String?
  /// normalizeName(name)|normalizeName(city): third deduplication key. Maintained by the application.
  nameKey        String?
  rating         Float?
  reviewCount    Int?
  /// 0-100 completeness reported by the source.
  completeness   Int?
  source         LeadSource @default(MANUAL)
  externalId     String?
  externalSource String?
  /// Raw useful fields kept for later enrichment; never read by business rules.
  data           Json?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  contacts Contact[]
  leads    Lead[]
  audits   ProspectAudit[]

  @@unique([workspaceId, externalId])
  @@index([workspaceId, domain])
  @@index([workspaceId, name])
  @@index([workspaceId, nameKey])
  @@index([workspaceId, siret])
  @@index([workspaceId, phone])
}

model Contact {
  id                 String     @id @default(cuid())
  workspaceId        String
  workspace          Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  companyId          String?
  company            Company?   @relation(fields: [companyId], references: [id], onDelete: SetNull)
  name               String?
  jobTitle           String?
  /// Stored lower-case (CHECK constraint).
  email              String?
  emailKind          EmailKind  @default(UNKNOWN)
  phone              String?
  doNotContact       Boolean    @default(false)
  doNotContactReason String?
  source             LeadSource @default(MANUAL)
  /// Where and when the data was collected, and on which legal basis: required to answer an access or opposition request.
  collectedFrom      String?
  collectedAt        DateTime?
  legalBasis         String?
  /// Former appointment "client" account this contact was created from (idempotent backfill).
  legacyUserId       String?    @unique
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  leads    Lead[]
  meetings Meeting[]
  emails   EmailMessage[]

  @@unique([workspaceId, email])
  @@index([workspaceId, companyId])
}

model ImportBatch {
  id             String       @id @default(cuid())
  workspaceId    String
  workspace      Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  source         LeadSource
  status         ImportStatus @default(RUNNING)
  extractorJobId String?
  createdById    String?
  createdBy      User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  /// Search parameters or file name, for traceability.
  params         Json?
  total          Int          @default(0)
  created        Int          @default(0)
  existing       Int          @default(0)
  skipped        Int          @default(0)
  createdAt      DateTime     @default(now())
  finishedAt     DateTime?

  leads Lead[]

  @@index([workspaceId, createdAt])
  @@index([extractorJobId])
}

/// One prospect: a company, a contact, or both. A company has at most one lead.
model Lead {
  id              String       @id @default(cuid())
  workspaceId     String
  workspace       Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  companyId       String?
  company         Company?     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  contactId       String?
  contact         Contact?     @relation(fields: [contactId], references: [id], onDelete: Restrict)
  ownerId         String?
  owner           User?        @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  status          LeadStatus   @default(NEW)
  /// 0-100, rule based in V1; `scoreReasons` explains it.
  score           Int          @default(0)
  scoreReasons    Json?
  /// Guided qualification answers (need, budget, decision maker, timing), all optional.
  qualification   Json?
  source          LeadSource   @default(MANUAL)
  importBatchId   String?
  importBatch     ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  lastContactedAt DateTime?
  /// Free labels, stored lower-case.
  tags            String[]     @default([])
  /// E15: the campaign this fiche is worked in (at most one).
  campaignId      String?
  campaign        Campaign?    @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  deals               Deal[]
  activities          Activity[]
  tasks               Task[]
  meetings            Meeting[]
  emails              EmailMessage[]
  sequenceEnrollments SequenceEnrollment[]
  agentRuns           AgentRun[]
  audits              ProspectAudit[]
  offerPitches        OfferPitch[]
  emailDrafts         EmailDraft[]
  generatedSites      GeneratedSite[]
  relevances          LeadRelevance[]

  @@unique([workspaceId, companyId])
  @@index([workspaceId, status])
  @@index([workspaceId, ownerId, status])
  @@index([workspaceId, score])
  @@index([importBatchId])
  @@index([tags], type: Gin)
  @@index([campaignId])
}

model Deal {
  id              String    @id @default(cuid())
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  leadId          String
  lead            Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  ownerId         String?
  owner           User?     @relation("DealOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  stage           DealStage @default(QUALIFIED)
  /// Amount in cents; optional, so weighted pipeline figures are only shown when it is filled in.
  amountCents     Int?
  currency        String    @default("EUR")
  lostReason      String?
  expectedCloseAt DateTime?
  wonAt           DateTime?
  lostAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  activities Activity[]
  tasks      Task[]
  meetings   Meeting[]

  @@index([workspaceId, stage])
  @@index([workspaceId, ownerId, stage])
  @@index([leadId])
}

/// Everything that happens on a lead or a deal, in order.
model Activity {
  id          String         @id @default(cuid())
  workspaceId String
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  leadId      String?
  lead        Lead?          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  dealId      String?
  deal        Deal?          @relation(fields: [dealId], references: [id], onDelete: Cascade)
  actorId     String?
  actor       User?          @relation(fields: [actorId], references: [id], onDelete: SetNull)
  /// USER for people; AGENT for service accounts (V2); SYSTEM for automatic events.
  actorKind   AuditActorKind @default(USER)
  kind        ActivityKind
  body        String?
  data        Json?
  occurredAt  DateTime       @default(now())
  createdAt   DateTime       @default(now())

  @@index([leadId, occurredAt])
  @@index([dealId, occurredAt])
  @@index([workspaceId, occurredAt])
}

model Task {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  leadId      String?
  lead        Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  dealId      String?
  deal        Deal?     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  assigneeId  String?
  assignee    User?     @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdById String?
  createdBy   User?     @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  title       String
  dueAt       DateTime?
  doneAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([assigneeId, doneAt, dueAt])
  @@index([workspaceId, dueAt])
}

model Meeting {
  id                  String          @id @default(cuid())
  workspaceId         String
  workspace           Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  hostId              String
  host                User            @relation("MeetingHost", fields: [hostId], references: [id], onDelete: Restrict)
  leadId              String?
  lead                Lead?           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contactId           String?
  contact             Contact?        @relation(fields: [contactId], references: [id], onDelete: SetNull)
  dealId              String?
  deal                Deal?           @relation(fields: [dealId], references: [id], onDelete: SetNull)
  /// UTC instants; `timezone` (IANA) is where the host and the guest reason about the slot.
  startsAt            DateTime
  endsAt              DateTime
  timezone            String          @default("Europe/Paris")
  type                MeetingType     @default(DISCOVERY)
  status              MeetingStatus   @default(SCHEDULED)
  outcome             MeetingOutcome?
  videoUrl            String?
  notes               String?
  /// "booking" (public page), "sdr", "manual" or "legacy".
  source              String          @default("manual")
  createdById         String?
  createdBy           User?           @relation("MeetingCreator", fields: [createdById], references: [id], onDelete: SetNull)
  /// Former Appointment this meeting was created from (idempotent backfill).
  legacyAppointmentId String?         @unique
  canceledAt          DateTime?
  cancelReason        String?
  /// Set on the meeting that replaced this one when it was moved (this one then has status RESCHEDULED).
  rescheduledToId     String?         @unique
  rescheduledTo       Meeting?        @relation("MeetingMove", fields: [rescheduledToId], references: [id], onDelete: SetNull)
  rescheduledFrom     Meeting?        @relation("MeetingMove")
  /// Reminders go out once; the stamp is what makes the job safe to run every hour.
  reminderSentAt      DateTime?
  hostReminderSentAt  DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([hostId, startsAt])
  @@index([workspaceId, startsAt])
  @@index([leadId])
  @@index([status, startsAt])
}

/// Weekly working interval of a host, in minutes from midnight in `timezone`. A day with a break has two rows.
model AvailabilityRule {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  hostId      String
  host        User      @relation(fields: [hostId], references: [id], onDelete: Cascade)
  /// 0 = Sunday ... 6 = Saturday (same as JavaScript's Date.getDay).
  weekday     Int
  startMinute Int
  endMinute   Int
  timezone    String    @default("Europe/Paris")
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([hostId, weekday])
}

/// A specific day that overrides the weekly rules: off (default) or open between the given minutes.
model AvailabilityException {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  hostId      String
  host        User      @relation(fields: [hostId], references: [id], onDelete: Cascade)
  /// Calendar day in the host's timezone, stored as UTC midnight.
  date        DateTime  @db.Date
  available   Boolean   @default(false)
  startMinute Int?
  endMinute   Int?
  reason      String?
  createdAt   DateTime  @default(now())

  @@unique([hostId, date])
}

/// Addresses and domains that must never be contacted (unsubscribed, bounced, complained, manual).
model Suppression {
  id          String            @id @default(cuid())
  workspaceId String
  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email       String?
  domain      String?
  reason      SuppressionReason
  source      String?
  createdAt   DateTime          @default(now())

  @@unique([workspaceId, email])
  @@unique([workspaceId, domain])
}

model SavedView {
  id          String          @id @default(cuid())
  workspaceId String
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ownerId     String
  owner       User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  entity      SavedViewEntity
  name        String
  filters     Json
  shared      Boolean         @default(false)
  createdAt   DateTime        @default(now())

  @@index([workspaceId, entity])
  @@index([ownerId])
}

enum SearchStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

/// A search launched from the CRM on Cleads Extractor. The extractor keeps the results; this row remembers who asked,
/// what, and where it stands, and makes the completion webhook idempotent.
model ExtractionSearch {
  id             String       @id @default(cuid())
  workspaceId    String
  workspace      Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdById    String?
  createdBy      User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  /// Set once the extractor accepted the job.
  extractorJobId String?      @unique
  label          String
  /// What was asked: activity, location, enrichment, result cap.
  spec           Json
  status         SearchStatus @default(QUEUED)
  error          String?
  /// Last counters seen (raw found, unique, complete, useful, tasks).
  counters       Json?
  importedCount  Int          @default(0)
  lastImportAt   DateTime?
  notifiedAt     DateTime?
  /// E15: imports of this search file their fiches in this campaign.
  campaignId     String?
  campaign       Campaign?    @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  finishedAt     DateTime?

  strategyTargets StrategyTarget[]

  @@index([workspaceId, createdAt])
  @@index([createdById, status])
}

/// Public booking page of a host (`/rdv/<slug>`): how long a meeting lasts, how far ahead and how late it can be booked.
model BookingProfile {
  id           String    @id @default(cuid())
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  hostId       String    @unique
  host         User      @relation(fields: [hostId], references: [id], onDelete: Cascade)
  /// URL segment, lower-case letters, digits and dashes. Unique across the whole site because the page is public.
  slug         String    @unique
  enabled      Boolean   @default(false)
  timezone     String    @default("Europe/Paris")
  durationMin  Int       @default(30)
  /// Free time kept around every meeting.
  bufferMin    Int       @default(10)
  /// A slot closer than this to now is not offered.
  minNoticeMin Int       @default(120)
  horizonDays  Int       @default(21)
  videoUrl     String?
  intro        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

/// Counts of recent attempts on public endpoints, keyed by action and requester. Rows older than the window are inert and pruned.
model RateLimitHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

/// Which provider carries the CRM's own (transactional) emails. Credentials stay in environment variables, never here.
model MailSetting {
  workspaceId           String    @id
  workspace             Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// "ses" or "resend".
  transactionalProvider String    @default("ses")
  /// When the chosen provider fails, try the other one if it is configured.
  fallbackEnabled       Boolean   @default(true)
  updatedById           String?
  updatedAt             DateTime  @updatedAt
}

// ── Outreach email (E9a): dedicated mailboxes on secondary domains, never SES or Resend ─────────────────────────

enum MailboxProvider {
  /// Any provider reachable by SMTP (sending) and IMAP (copy in "Sent", replies in E9b).
  SMTP
}

enum MailboxStatus {
  ACTIVE
  /// Stopped by a person; nothing leaves it.
  PAUSED
  /// The last connection or send failed on credentials or the server: fixed by a new test.
  ERROR
}

enum EmailDirection {
  OUTBOUND
  INBOUND
}

enum EmailStatus {
  /// The slot is reserved in the day's quota and the message is on its way.
  SENDING
  SENT
  FAILED
  BOUNCED
  /// An INBOUND message read from a mailbox (E9b).
  RECEIVED
}

/// How a person filed a reply (E9b). `STOP` also stops all prospecting to the sender.
enum ReplyClass {
  INTERESTED
  NOT_NOW
  NOT_INTERESTED
  OUT_OF_OFFICE
  WRONG_PERSON
  STOP
  OTHER
}

/// A real mailbox prospecting mail leaves from. Its password is encrypted (lib/crypto/secret-box) and never sent to the browser.
model Mailbox {
  id              String          @id @default(cuid())
  workspaceId     String
  workspace       Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// The person who sends from it; owners and managers may use every mailbox.
  ownerId         String?
  owner           User?           @relation("MailboxOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  /// Stored lower-case (CHECK constraint).
  address         String
  displayName     String
  provider        MailboxProvider @default(SMTP)
  smtpHost        String
  smtpPort        Int
  /// TLS from the first byte (port 465); otherwise STARTTLS is required.
  smtpSecure      Boolean         @default(true)
  username        String
  /// AES-256-GCM sealed password (`v1.<iv>.<tag>.<data>`).
  secret          String
  imapHost        String?
  imapPort        Int?
  imapSecure      Boolean         @default(true)
  /// IMAP folder a copy of each sent message is filed in; null = found automatically.
  sentFolder      String?
  /// Hard ceiling per day once warmed up. The worker and the 1-to-1 send both enforce it.
  dailyCap        Int             @default(30)
  /// Day 0 of the progressive warm-up; the allowance grows week after week from here.
  warmupStartedAt DateTime        @default(now())
  status          MailboxStatus   @default(ACTIVE)
  statusReason    String?
  /// Plain-text signature added under every message.
  signature       String?
  lastTestedAt    DateTime?
  /// E9b: highest INBOX UID already read, and the UIDVALIDITY it belongs to (a change means the numbering restarted).
  imapLastUid     Int?
  imapUidValidity String?
  lastPolledAt    DateTime?
  /// Why the last read failed; null once a read works again.
  lastPollError   String?
  /// E9c: health (bounces, opt-outs) is measured from this moment when set: a person who fixed an auto-paused mailbox starts a fresh count.
  healthResetAt   DateTime?
  /// Set while a read is running so two overlapping runs do not read the same mailbox.
  pollClaimedAt   DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  messages    EmailMessage[]
  enrollments SequenceEnrollment[]

  @@unique([workspaceId, address])
  @@index([workspaceId, ownerId])
}

/// A reusable message with variables (`{{prenom}}`, `{{entreprise|votre entreprise}}`…), plain text.
model EmailTemplate {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  subject     String
  body        String
  createdById String?
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  /// Archived templates stay attached to the messages sent with them but are no longer offered.
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  messages EmailMessage[]

  @@unique([workspaceId, name])
}

/// One prospecting email, sent or received. The day's quota of a mailbox is counted on these rows.
model EmailMessage {
  id             String              @id @default(cuid())
  workspaceId    String
  workspace      Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  mailboxId      String
  mailbox        Mailbox             @relation(fields: [mailboxId], references: [id], onDelete: Restrict)
  leadId         String?
  lead           Lead?               @relation(fields: [leadId], references: [id], onDelete: SetNull)
  contactId      String?
  contact        Contact?            @relation(fields: [contactId], references: [id], onDelete: SetNull)
  sentById       String?
  sentBy         User?               @relation("EmailSender", fields: [sentById], references: [id], onDelete: SetNull)
  templateId     String?
  template       EmailTemplate?      @relation(fields: [templateId], references: [id], onDelete: SetNull)
  direction      EmailDirection      @default(OUTBOUND)
  status         EmailStatus
  fromEmail      String
  toEmail        String
  subject        String
  bodyText       String
  /// RFC 5322 Message-ID, with the angle brackets: replies are matched on it (E9b).
  messageId      String              @unique
  inReplyTo      String?
  error          String?
  /// A test sent to a member's own address: counted in the quota, never on a fiche.
  isTest         Boolean             @default(false)
  /// INBOUND: how a person (or the reader, for out-of-office notices) filed the reply.
  replyClass     ReplyClass?
  /// INBOUND: when someone opened it in the CRM; null = unread.
  readAt         DateTime?
  /// INBOUND: the message we sent that this answers.
  repliesToId    String?
  /// E9c: the sequence enrollment this message was sent for, and its step (1 = first message).
  enrollmentId   String?
  enrollment     SequenceEnrollment? @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  stepNumber     Int?
  /// OUTBOUND: when the recipient used this message's unsubscribe link. Attributes opt-outs to a mailbox.
  unsubscribedAt DateTime?
  /// OUTBOUND: when the server accepted it; INBOUND: the message's own date.
  sentAt         DateTime?
  createdAt      DateTime            @default(now())
  /// E22: drafts answering this reply, the draft this message was sent from, and the suggested filing.
  draftsReplying EmailDraft[]        @relation("DraftReplyTo")
  fromDraft      EmailDraft?         @relation("DraftSent")
  triage         ReplyTriage?

  @@index([mailboxId, createdAt])
  @@index([workspaceId, direction, createdAt])
  @@index([enrollmentId])
  @@index([leadId, createdAt])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, toEmail])
}

// ── Sequences (E9c): a few timed follow-ups, stopped automatically ──────────────────────────────────────────────

enum SequenceStatus {
  ACTIVE
  /// Nothing is sent for it; its enrollments wait.
  PAUSED
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  STOPPED
}

enum EnrollmentStopReason {
  REPLIED
  BOUNCED
  UNSUBSCRIBED
  COMPLAINED
  /// The address joined the exclusion list some other way (manual, domain).
  SUPPRESSED
  DO_NOT_CONTACT
  /// The fiche was qualified, disqualified or otherwise left prospecting.
  LEAD_CLOSED
  /// No address, or a template variable the fiche cannot fill.
  MISSING_DATA
  SEND_FAILED
  MANUAL
}

model Sequence {
  id          String         @id @default(cuid())
  workspaceId String
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  status      SequenceStatus @default(ACTIVE)
  createdById String?
  createdBy   User?          @relation("SequenceCreator", fields: [createdById], references: [id], onDelete: SetNull)
  /// Archived sequences keep their history but take no new enrollment and send nothing.
  archivedAt  DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  steps       SequenceStep[]
  enrollments SequenceEnrollment[]

  @@unique([workspaceId, name])
}

model SequenceStep {
  id         String   @id @default(cuid())
  sequenceId String
  sequence   Sequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  /// 1-based. Step 1 goes out at enrollment; the others `delayDays` after the previous one.
  position   Int
  delayDays  Int      @default(0)
  /// Empty on steps 2+ = a reply in the first message's thread ("Re: …").
  subject    String
  body       String

  @@unique([sequenceId, position])
}

model SequenceEnrollment {
  id            String                @id @default(cuid())
  workspaceId   String
  workspace     Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sequenceId    String
  sequence      Sequence              @relation(fields: [sequenceId], references: [id], onDelete: Restrict)
  leadId        String
  lead          Lead                  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  mailboxId     String
  mailbox       Mailbox               @relation(fields: [mailboxId], references: [id], onDelete: Restrict)
  enrolledById  String?
  enrolledBy    User?                 @relation("EnrollmentCreator", fields: [enrolledById], references: [id], onDelete: SetNull)
  status        EnrollmentStatus      @default(ACTIVE)
  stoppedReason EnrollmentStopReason?
  /// Steps already sent.
  currentStep   Int                   @default(0)
  /// When the next step may leave (null once finished). The worker takes a short lease on it while sending.
  nextAt        DateTime?
  lastSentAt    DateTime?
  /// Consecutive failed attempts on the current step.
  failures      Int                   @default(0)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  stoppedAt     DateTime?

  messages EmailMessage[]

  @@index([status, nextAt])
  @@index([leadId])
  @@index([sequenceId, status])
}

// ── Campaigns (E15): a target worked over a period; every figure is computed from leads, emails, deals, meetings ──

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
}

/// An acquisition campaign: one target (sector × area, an offer) worked over a period. Fiches and Extractor searches
/// are filed in it; its results are always computed from them (features/metrics), never stored.
model Campaign {
  id           String         @id @default(cuid())
  workspaceId  String
  workspace    Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name         String
  /// Offer, angle, who it is for. Free text.
  description  String?
  status       CampaignStatus @default(DRAFT)
  /// Target as people describe it ("Assurance", "Suisse romande"): a reminder and a default for searches, never a rule.
  sector       String?
  area         String?
  ownerId      String?
  owner        User?          @relation("CampaignOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  /// Calendar days (UTC midnight); both optional.
  startsOn     DateTime?      @db.Date
  endsOn       DateTime?      @db.Date
  /// Optional goals, shown as progress next to the measured figures.
  goalLeads    Int?
  goalMeetings Int?
  /// E25: the offer the campaign leads with; Jev judges its fiches against it.
  offerId      String?
  offer        Offer?         @relation(fields: [offerId], references: [id], onDelete: SetNull)
  createdById  String?
  createdBy    User?          @relation("CampaignCreator", fields: [createdById], references: [id], onDelete: SetNull)
  /// Archived campaigns keep their fiches and figures but are no longer offered.
  archivedAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  leads           Lead[]
  searches        ExtractionSearch[]
  agentRuns       AgentRun[]
  strategyTargets StrategyTarget[]
  relevances      LeadRelevance[]

  @@unique([workspaceId, name])
  @@index([workspaceId, status])
}

// ---------------------------------------------------------------------------------------------------------------------
// E17: AI foundation (docs/crm-v1/AGENTS-IA.md). Amounts are micro-euros (1 € = 1 000 000), converted from the
// Gateway's dollar prices at the workspace rate when each call is recorded.

enum AgentRunStatus {
  QUEUED
  RUNNING
  WAITING_APPROVAL
  SUCCEEDED
  FAILED
  CANCELLED
  BUDGET_EXCEEDED
  EXPIRED
}

enum AgentStepType {
  MODEL
  TOOL
  DECISION
  APPROVAL
}

enum AgentApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

/// One row per workspace, created on first save: models per role and spending caps. No row = the defaults
/// (lib/ai/models.ts, lib/ai/budget.ts). The row is also the lock that serialises budget reservations.
model AiSetting {
  id                 String    @id @default(cuid())
  workspaceId        String    @unique
  workspace          Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// { role: modelId } overrides of the defaults; entries outside a role's allow list are ignored.
  roleModels         Json?
  /// Hard monthly cap for the workspace.
  monthlyCapMicros   Int       @default(100000000)
  /// Daily quota per person, inside the monthly cap.
  userDailyCapMicros Int       @default(5000000)
  /// Euros per US dollar, to convert the Gateway's prices.
  eurPerUsd          Float     @default(0.92)
  /// Budget alerts already sent: { "YYYY-MM": [50, 80, 100] }.
  alerts             Json?
  /// E19: when the V1 skills and offers were installed (once; deleting them later does not bring them back).
  catalogSeededAt    DateTime?
  /// E28: the catalogue additions installed since (features/ai/catalog.ts); 1 = the V1 catalogue alone.
  catalogVersion     Int       @default(1)
  /// E28 (D32): most a mission may spend on AI before a second confirmation.
  missionCapMicros   Int       @default(2000000)
  updatedById        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

/// Spend per day, person, agent and model; the month's total is the sum of its rows. Upserted after every call.
model AiUsage {
  id                String    @id @default(cuid())
  workspaceId       String
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// UTC calendar day.
  day               DateTime  @db.Date
  /// The member's id, or "system" for scheduled runs (a key, not a relation: history outlives accounts).
  userKey           String
  agentId           String
  model             String
  calls             Int       @default(0)
  inputTokens       Int       @default(0)
  outputTokens      Int       @default(0)
  cachedInputTokens Int       @default(0)
  costMicros        Int       @default(0)

  @@unique([workspaceId, day, userKey, agentId, model])
  @@index([workspaceId, day])
}

/// One AI execution: who it acts for, which agent, on which fiche, its status and its cost.
model AgentRun {
  id             String         @id @default(cuid())
  workspaceId    String
  workspace      Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agentId        String
  status         AgentRunStatus @default(QUEUED)
  /// The person the run acts for: every tool checks this person's rights. Null for scheduled runs.
  requestedById  String?
  requestedBy    User?          @relation("AgentRunRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  leadId         String?
  lead           Lead?          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  campaignId     String?
  campaign       Campaign?      @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  parentRunId    String?
  parentRun      AgentRun?      @relation("AgentRunChildren", fields: [parentRunId], references: [id], onDelete: SetNull)
  children       AgentRun[]     @relation("AgentRunChildren")
  /// E28: the mission this run works for; its cost counts against the mission's cap.
  missionId      String?
  mission        AgentMission?  @relation(fields: [missionId], references: [id], onDelete: SetNull)
  input          Json?
  output         Json?
  error          String?
  /// The run's own cap: the budget reserved for it when it started.
  capMicros      Int
  /// Part of the cap still held while the run is active; 0 once it ends.
  reservedMicros Int            @default(0)
  /// Cost recorded so far.
  costMicros     Int            @default(0)
  /// Number of steps, also the next step's index.
  stepCount      Int            @default(0)
  // E18: the run is its own queue entry (features/ai/queue.ts).
  /// Higher first, then oldest first.
  priority       Int            @default(0)
  /// Times a worker took it; a run is given up after three.
  attempts       Int            @default(0)
  /// Not before this time (a retry waits).
  notBefore      DateTime?
  /// The worker running it; null for work done during a CRM request.
  lockedBy       String?
  /// Refreshed by the worker while it runs: a stale lease means the worker stopped.
  heartbeatAt    DateTime?
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  steps       AgentStep[]
  approvals   AgentApproval[]
  audit       ProspectAudit?
  pitch       OfferPitch?
  draft       EmailDraft?
  triages     ReplyTriage[]
  siteVersion GeneratedSiteVersion?
  aiMessages  AiMessage[]
  strategy    StrategyProposal?
  relevances  LeadRelevance[]
  evaluation  AiEvaluation?

  @@index([workspaceId, createdAt])
  @@index([workspaceId, status])
  @@index([leadId, createdAt])
  @@index([requestedById, createdAt])
  @@index([status, priority, createdAt])
  @@index([missionId])
}

/// What a run did, in order: model calls, tools, decisions, approvals. Inputs and outputs are truncated.
model AgentStep {
  id                String        @id @default(cuid())
  runId             String
  run               AgentRun      @relation(fields: [runId], references: [id], onDelete: Cascade)
  index             Int
  type              AgentStepType
  name              String
  model             String?
  input             Json?
  output            Json?
  inputTokens       Int           @default(0)
  outputTokens      Int           @default(0)
  cachedInputTokens Int           @default(0)
  costMicros        Int           @default(0)
  durationMs        Int           @default(0)
  /// Gateway generation id, to reconcile the estimated cost with the Gateway's own.
  generationId      String?
  createdAt         DateTime      @default(now())

  @@unique([runId, index])
}

/// A tool call that leaves the CRM (email, search, shared link) waits here for a person.
model AgentApproval {
  id                 String              @id @default(cuid())
  workspaceId        String
  workspace          Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  runId              String
  run                AgentRun            @relation(fields: [runId], references: [id], onDelete: Cascade)
  tool               String
  /// The right the decider must hold to allow the call (lib/rbac.ts).
  permission         String?
  /// The exact arguments, executed as they are once approved.
  payload            Json
  /// What will happen, in one sentence, for the person who decides.
  summary            String
  status             AgentApprovalStatus @default(PENDING)
  requestedById      String?
  requestedBy        User?               @relation("ApprovalRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  decidedById        String?
  decidedBy          User?               @relation("ApprovalDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt          DateTime?
  /// Why it was rejected, kept in the run's history.
  note               String?
  expiresAt          DateTime
  createdAt          DateTime            @default(now())
  /// E18: an approved call runs at most once. Set before it runs; a start without an end means "maybe done".
  executionStartedAt DateTime?
  executedAt         DateTime?
  /// What the call returned, or its error.
  result             Json?

  @@index([workspaceId, status, createdAt])
  @@index([runId])
  @@index([requestedById, status])
}

/// E18: one row per AI worker process, refreshed every few seconds: Réglages › IA shows whether a worker is up.
model AiWorker {
  /// WORKER_ID, stable across restarts of the same container.
  id        String   @id
  version   String
  host      String?
  startedAt DateTime
  beatAt    DateTime
  /// Runs in progress on this worker.
  running   Int      @default(0)
}

// E19: agents, skills and offers catalogue (docs/crm-v1/AGENTS-IA.md §7, §8 and §14).

enum SkillMode {
  ALWAYS
  ON_DEMAND
}

enum OfferCategory {
  WEBSITE
  SEO
  GEO
  SOCIAL
  ADS
  PACK
  RETAINER
}

enum OfferBilling {
  ONE_OFF
  MONTHLY
  QUOTE
}

enum OfferStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

/// The workspace's layer over an agent defined in the code (features/ai/agents.ts): it adds to it, never replaces it.
model AgentDefinition {
  id            String                   @id @default(cuid())
  workspaceId   String
  workspace     Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agentId       String
  /// Added after the agent's own instructions.
  instructions  String?
  /// One of the agent's allowed model roles; null = the code's.
  modelRole     String?
  /// At most the code's limits; null = the code's.
  maxSteps      Int?
  maxCostMicros Int?
  /// A disabled agent cannot be started.
  enabled       Boolean                  @default(true)
  /// E28: the families of actions set apart from the code (features/ai/actions/policy.ts); null = the code's.
  actionPolicy  Json?
  /// Raised by every saved change; the history is in AgentDefinitionVersion.
  version       Int                      @default(0)
  updatedById   String?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  versions      AgentDefinitionVersion[]

  @@unique([workspaceId, agentId])
}

/// One saved state of an agent's layer, skills included, for its history.
model AgentDefinitionVersion {
  id           String          @id @default(cuid())
  definitionId String
  definition   AgentDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  version      Int
  snapshot     Json
  /// What changed: instructions, skills, model, limits, enabled.
  changes      String[]
  createdById  String?
  createdAt    DateTime        @default(now())

  @@unique([definitionId, version])
}

/// A know-how given to agents without touching the code (SKILL.md, agentskills.io). Its content lives in SkillVersion.
model Skill {
  id          String         @id @default(cuid())
  workspaceId String
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// kebab-case and unique in the workspace: what agents pass to read_skill. Never changes.
  name        String
  /// When to use it, as agents see it in their catalogue. The current version's.
  description String
  /// Current version.
  version     Int            @default(1)
  /// "offers": the content is written from the active offers at each use (the skill offres-cleads).
  generator   String?
  /// Archived skills are no longer given to agents; their versions stay readable.
  archivedAt  DateTime?
  createdById String?
  updatedById String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  versions    SkillVersion[]
  agents      AgentSkill[]

  @@unique([workspaceId, name])
}

/// Every saved state of a skill: a change creates a version, the earlier ones stay readable.
model SkillVersion {
  id          String   @id @default(cuid())
  skillId     String
  skill       Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  version     Int
  description String
  /// The SKILL.md body, without its front matter.
  content     String
  /// Text files next to SKILL.md: [{ path, content }].
  files       Json?
  /// What changed, in a few words.
  note        String?
  createdById String?
  createdAt   DateTime @default(now())

  @@unique([skillId, version])
}

/// A skill given to an agent: ALWAYS (its content is part of the agent's instructions) or ON_DEMAND (read_skill).
model AgentSkill {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agentId     String
  skillId     String
  skill       Skill     @relation(fields: [skillId], references: [id], onDelete: Cascade)
  mode        SkillMode
  createdAt   DateTime  @default(now())

  @@unique([skillId, agentId])
  @@index([workspaceId, agentId])
}

/// An offer of the catalogue: agents only ever recommend active ones.
model Offer {
  id              String                @id @default(cuid())
  workspaceId     String
  workspace       Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// kebab-case and stable: rules and recommendations refer to it.
  slug            String
  name            String
  category        OfferCategory
  summary         String
  deliverables    String[]              @default([])
  /// Audit signals that call for it (features/offers/signals.ts).
  signals         String[]              @default([])
  /// Euros excluding tax; both null on quote.
  priceMinEur     Int?
  priceMaxEur     Int?
  billing         OfferBilling          @default(ONE_OFF)
  /// "hors budget média", "engagement initial de 3 mois"…
  priceNote       String?
  /// The argument to open with.
  angle           String?
  /// [{ objection, answer }]
  objections      Json?
  status          OfferStatus           @default(DRAFT)
  sortOrder       Int                   @default(0)
  /// Who checked it last, when it was activated.
  reviewedById    String?
  reviewedAt      DateTime?
  createdById     String?
  updatedById     String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  recommendations OfferRecommendation[]
  campaigns       Campaign[]
  strategyTargets StrategyTarget[]

  @@unique([workspaceId, slug])
  @@index([workspaceId, status])
}

// E20: prospect audits (docs/crm-v1/AGENTS-IA.md §13).

enum AuditStatus {
  /// Everything that could be checked was checked (a missing website is a finding, not a gap).
  COMPLETE
  /// Something could not be checked (site unreachable, PageSpeed unavailable…): `report.notes` says what.
  PARTIAL
}

/// The audit of a prospect's online presence: eight sub-scores with their evidence, findings and a summary for the closer.
model ProspectAudit {
  id          String                 @id @default(cuid())
  workspaceId String
  workspace   Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  leadId      String?
  lead        Lead?                  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  companyId   String?
  company     Company?               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  runId       String?                @unique
  run         AgentRun?              @relation(fields: [runId], references: [id], onDelete: SetNull)
  /// Lower-case host without "www.": an audit is reused for 30 days by every fiche of this domain.
  domain      String?
  /// The page actually audited, after redirects.
  url         String?
  status      AuditStatus
  /// { technique, vitesse, mobile, seoLocal, geo, conversion, presence, image }: 0-100, null when not measured.
  scores      Json
  /// Average of the measured sub-scores.
  score       Int?
  /// Three points for the closer.
  summary     String[]
  /// Findings, strengths, weaknesses, frictions, opportunities, signals, evidence, proposed contacts, notes
  /// (features/prospect-audit/schemas.ts, auditReportSchema).
  report      Json
  costMicros  Int                    @default(0)
  validUntil  DateTime
  createdById String?
  createdAt   DateTime               @default(now())
  captures    ProspectAuditCapture[]
  pitches     OfferPitch[]
  drafts      EmailDraft[]
  sites       GeneratedSite[]

  @@index([workspaceId, domain, createdAt])
  @@index([leadId, createdAt])
}

/// Screenshots of the audited site (from PageSpeed Insights), deleted with their audit.
model ProspectAuditCapture {
  id        String        @id @default(cuid())
  auditId   String
  audit     ProspectAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)
  /// "mobile" or "desktop".
  kind      String
  mediaType String
  data      Bytes
  createdAt DateTime      @default(now())

  @@unique([auditId, kind])
}

// E21: offers and pitch (docs/crm-v1/AGENTS-IA.md §14).

/// Where an offer stands in the pitch: the main offer, the rest of the pack, a cheaper first step, or an idea for later.
enum RecommendationRole {
  MAIN
  COMPLEMENT
  ENTRY
  LATER
}

/// What the person made of a suggested offer; kept to measure the advisor's relevance (E27).
enum RecommendationStatus {
  SUGGESTED
  ACCEPTED
  REJECTED
}

enum RejectionReason {
  NOT_RELEVANT
  TOO_EXPENSIVE
  ALREADY_HAS
  BAD_TIMING
  OTHER
}

/// The Conseiller offres' work on a fiche: the offers it recommends from the audit, the call script, the objections and
/// the email angle. The latest one is shown; older ones stay for their decisions.
model OfferPitch {
  id              String                @id @default(cuid())
  workspaceId     String
  workspace       Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  leadId          String
  lead            Lead                  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  /// The audit it was built from; the evidence it cites is copied below, so it stays readable once the audit is gone.
  auditId         String?
  audit           ProspectAudit?        @relation(fields: [auditId], references: [id], onDelete: SetNull)
  runId           String?               @unique
  run             AgentRun?             @relation(fields: [runId], references: [id], onDelete: SetNull)
  /// One sentence for the closer: why this prospect needs the agency.
  headline        String
  /// { opening, hook: { text, evidence }, questions, proposal, close } (features/offer-pitch/schemas.ts).
  script          Json
  /// [{ objection, answer }]: the most likely ones in the call.
  objections      Json
  /// { subject, angle, evidence }, for the first email (E22); null when it cited no valid evidence.
  emailAngle      Json?
  /// The audit evidence the pitch cites: [{ id, kind, label, value, url }].
  evidence        Json
  /// What was left out, and why.
  notes           String[]              @default([])
  model           String?
  costMicros      Int                   @default(0)
  createdById     String?
  createdAt       DateTime              @default(now())
  recommendations OfferRecommendation[]

  @@index([leadId, createdAt])
  @@index([workspaceId, createdAt])
}

/// One offer of a pitch, as it was recommended (name and price copied), and what the person decided.
model OfferRecommendation {
  id          String               @id @default(cuid())
  workspaceId String
  workspace   Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pitchId     String
  pitch       OfferPitch           @relation(fields: [pitchId], references: [id], onDelete: Cascade)
  offerId     String?
  offer       Offer?               @relation(fields: [offerId], references: [id], onDelete: SetNull)
  /// 1 for the main offer, then the pack, the entry offer and the ideas for later.
  rank        Int
  role        RecommendationRole
  offerSlug   String
  offerName   String
  category    OfferCategory
  priceMinEur Int?
  priceMaxEur Int?
  billing     OfferBilling
  priceNote   String?
  /// 0-100: how well the offer fits the prospect, according to the advisor.
  fit         Int
  /// Audit signals that made it a candidate (features/offers/signals.ts).
  signals     String[]             @default([])
  why         String
  gain        String
  /// Identifiers of the audit evidence the argument relies on: at least one.
  evidence    String[]
  objection   String?
  answer      String?
  status      RecommendationStatus @default(SUGGESTED)
  /// Only when rejected.
  reason      RejectionReason?
  note        String?
  decidedById String?
  decidedAt   DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@unique([pitchId, offerSlug])
  @@unique([pitchId, rank])
  @@index([workspaceId, status])
  @@index([offerId, status])
}

// E22: drafting and replies (docs/crm-v1/AGENTS-IA.md §15).

enum DraftKind {
  /// The first email to a fiche, from its audit.
  FIRST_EMAIL
  /// An answer to a reply received.
  REPLY
  /// A step of a sequence: a template with variables, for many fiches.
  SEQUENCE_STEP
}

/// A draft written by the Rédacteur outreach: never sent by itself, always read and edited by a person first.
model EmailDraft {
  id          String         @id @default(cuid())
  workspaceId String
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  kind        DraftKind
  leadId      String?
  lead        Lead?          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  /// REPLY: the message received that it answers.
  replyToId   String?
  replyTo     EmailMessage?  @relation("DraftReplyTo", fields: [replyToId], references: [id], onDelete: Cascade)
  /// The audit its facts come from.
  auditId     String?
  audit       ProspectAudit? @relation(fields: [auditId], references: [id], onDelete: SetNull)
  runId       String?        @unique
  run         AgentRun?      @relation(fields: [runId], references: [id], onDelete: SetNull)
  subject     String
  body        String
  /// The facts it relies on, each with the audit evidence it cites, copied: [{ text, evidence: [{ id, kind, label, value, url }] }].
  facts       Json           @default("[]")
  /// What was left out or must be checked, and why.
  notes       String[]       @default([])
  model       String?
  costMicros  Int            @default(0)
  createdById String?
  createdAt   DateTime       @default(now())
  /// The message sent from it, and how much the person changed it: 0 = sent as written, 1 = rewritten.
  sentEmailId String?        @unique
  sentEmail   EmailMessage?  @relation("DraftSent", fields: [sentEmailId], references: [id], onDelete: SetNull)
  editRatio   Float?
  sentAt      DateTime?

  @@index([workspaceId, createdAt])
  @@index([leadId, createdAt])
}

enum ReplyUrgency {
  HIGH
  NORMAL
  LOW
}

/// Where a suggestion stands against the thresholds (lib/ai/decide.ts): confirmed in one click, or left to a person.
enum TriageOutcome {
  AUTO
  REVIEW
  HUMAN
}

/// How the Analyste réponses (Jev) would file a reply, with its probabilities. A person confirms or files it otherwise.
model ReplyTriage {
  id                String        @id @default(cuid())
  workspaceId       String
  workspace         Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  emailId           String        @unique
  email             EmailMessage  @relation(fields: [emailId], references: [id], onDelete: Cascade)
  runId             String?
  run               AgentRun?     @relation(fields: [runId], references: [id], onDelete: SetNull)
  /// Null when the model gave no answer.
  replyClass        ReplyClass?
  classConfidence   Float?
  outcome           TriageOutcome
  urgency           ReplyUrgency?
  urgencyConfidence Float?
  needsAction       Boolean?
  actionConfidence  Float?
  model             String
  createdAt         DateTime      @default(now())

  @@index([workspaceId, createdAt])
}

// E23: Studio Web (docs/crm-v1/AGENTS-IA.md §16).

/// Where a site stands. A run that fails leaves the status as it was: the run's own status and error say what happened.
enum StudioSiteStatus {
  /// The Designer collects the site and writes the brief.
  BRIEFING
  /// The brief waits for a person, who may edit it before the page is generated.
  BRIEF_READY
  /// A version is being generated, from the brief or from an instruction.
  BUILDING
  /// At least one version is published.
  READY
  /// Its content was deleted after 90 days: only the record remains.
  PURGED
}

/// A demonstration landing page the Designer web made for one fiche, from its site, its audit and its brand.
model GeneratedSite {
  id              String           @id @default(cuid())
  workspaceId     String
  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  leadId          String
  lead            Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  /// The audit it starts from; the brief copies what it uses, so the site stays readable without it.
  auditId         String?
  audit           ProspectAudit?   @relation(fields: [auditId], references: [id], onDelete: SetNull)
  status          StudioSiteStatus @default(BRIEFING)
  /// The company's name when the site was made: the banner and the lists keep it.
  companyName     String
  /// What the collector found: colours, fonts, images, contact details (features/studio/schemas.ts, collectedSchema).
  collected       Json?
  /// The brief as the Designer wrote it, then as the person last edited it (briefSchema).
  brief           Json?
  briefEditedById String?
  briefEditedAt   DateTime?
  /// The run working on the site, or the last one: its status and error say how it went.
  lastRunId       String?
  /// The version the link shows; null until the first one is built.
  currentVersion  Int?
  /// Share link: the token is derived from this nonce with a server secret (features/studio/link.ts); only its hash is kept.
  linkNonce       String?
  tokenHash       String?          @unique
  linkCreatedById String?
  linkCreatedAt   DateTime?
  linkExpiresAt   DateTime?
  visitCount      Int              @default(0)
  lastVisitAt     DateTime?
  createdById     String?
  /// The content is deleted after this date: 90 days after the last version or link renewal. The record stays.
  purgeAfter      DateTime
  purgedAt        DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  versions GeneratedSiteVersion[]
  assets   GeneratedSiteAsset[]
  visits   GeneratedSiteVisit[]

  @@index([workspaceId, createdAt])
  @@index([leadId, createdAt])
  @@index([purgeAfter])
}

/// One version of a site: the page as published, its renders, its checks and what it cost.
model GeneratedSiteVersion {
  id             String        @id @default(cuid())
  siteId         String
  site           GeneratedSite @relation(fields: [siteId], references: [id], onDelete: Cascade)
  number         Int
  /// The person's instruction this version answers; null when it was built from the brief.
  instruction    String?
  runId          String?       @unique
  run            AgentRun?     @relation(fields: [runId], references: [id], onDelete: SetNull)
  /// The page: sanitised, Tailwind compiled in, images referenced as cleads-asset:<name>. Null once purged.
  html           String?
  /// JPEG renders: the full page on a computer (1440 px) and on a phone (390 px), and the first screen on a computer.
  desktop        Bytes?
  mobile         Bytes?
  thumb          Bytes?
  /// Sanitiser notes, axe-core violations, the critique grid and the correction rounds (checksSchema).
  checks         Json
  /// PageSpeed of the published page, { mobile, desktop }; null until measured, or when it could not be.
  scores         Json?
  /// The short-lived token PageSpeed reads the page with (hash only).
  probeHash      String?       @unique
  probeExpiresAt DateTime?
  model          String?
  costMicros     Int           @default(0)
  createdById    String?
  createdAt      DateTime      @default(now())

  @@unique([siteId, number])
}

/// Images and fonts of a site, hosted by us: a published page loads nothing from anywhere else.
model GeneratedSiteAsset {
  id        String        @id @default(cuid())
  siteId    String
  site      GeneratedSite @relation(fields: [siteId], references: [id], onDelete: Cascade)
  /// The name pages use (asset:<name>): logo, image-1…, font-…
  name      String
  /// "logo", "image" or "font".
  kind      String
  mediaType String
  data      Bytes
  width     Int?
  height    Int?
  /// The prospect's page or the font service it came from.
  sourceUrl String?
  /// The text alternative found on the site, or the font family.
  label     String?
  createdAt DateTime      @default(now())

  @@unique([siteId, name])
}

/// A browser displayed the shared page (D25): the date only, with no cookie and no IP address.
model GeneratedSiteVisit {
  id        String        @id @default(cuid())
  siteId    String
  site      GeneratedSite @relation(fields: [siteId], references: [id], onDelete: Cascade)
  version   Int
  createdAt DateTime      @default(now())

  @@index([siteId, createdAt])
}

// E24: the copilot (docs/crm-v1/AGENTS-IA.md §17).

enum AiMessageRole {
  USER
  ASSISTANT
}

/// A conversation with the copilot. It belongs to its person alone; it is deleted with any fiche it read, and 90 days
/// after its last message.
model AiConversation {
  id            String    @id @default(cuid())
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The first question, shortened: the history lists it.
  title         String
  /// The page it was started from: { path, kind, label }.
  context       Json?
  /// Fiches its tools read or acted on: the AI data of a fiche follows the fiche.
  leadIds       String[]  @default([])
  /// A turn is in progress since then: one at a time. Free again when it ends, or when it outlived any request.
  turnStartedAt DateTime?
  messageCount  Int       @default(0)
  /// What its turns cost, all together.
  costMicros    Int       @default(0)
  lastMessageAt DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  messages AiMessage[]

  @@index([workspaceId, userId, lastMessageAt])
  @@index([leadIds], type: Gin)
  @@index([lastMessageAt])
}

/// One message, in the AI SDK's UI format: text, and tool calls with their approval and result.
model AiMessage {
  id             String         @id @default(cuid())
  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// Its id in the chat: given by the browser for a question, by the server for an answer.
  uiId           String
  /// Order in the conversation, from 1.
  seq            Int
  role           AiMessageRole
  parts          Json
  /// A question: { context }. An answer: { runIds, costMicros, model, stopped }.
  metadata       Json?
  /// The last turn that wrote this answer.
  runId          String?
  run            AgentRun?      @relation(fields: [runId], references: [id], onDelete: SetNull)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([conversationId, uiId])
  @@unique([conversationId, seq])
  @@index([runId])
}

// E25: the Stratège and the sorting of imported fiches (docs/crm-v1/AGENTS-IA.md §17).

enum StrategyTargetStatus {
  PROPOSED
  CAMPAIGN
  LAUNCHED
  DISMISSED
}

enum RelevanceVerdict {
  RELEVANT
  MAYBE
  NOT_RELEVANT
}

/// What a Stratège run proposes: a few targets, each argued. It creates and launches nothing: a person turns a target
/// into a draft campaign, then launches its search through the CRM's search service.
model StrategyProposal {
  id            String    @id @default(cuid())
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// The run writing it; its status says whether the proposal is ready.
  runId         String?   @unique
  run           AgentRun? @relation(fields: [runId], references: [id], onDelete: SetNull)
  requestedById String?
  requestedBy   User?     @relation(fields: [requestedById], references: [id], onDelete: SetNull)
  /// What the person asked: { zone, focus, offerSlug }.
  brief         Json
  /// Its reading of the situation, in a few sentences.
  summary       String?
  /// Where its sectors came from: "extractor" (its taxonomy) or "crm" (when the Extractor did not answer).
  sectorsFrom   String?
  model         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  targets StrategyTarget[]

  @@index([workspaceId, createdAt])
}

/// One target of a proposal: a sector and its zones, its pains, the offer to lead with and the angle, why, and the
/// campaign and search it suggests. Its status follows what the person did with it.
model StrategyTarget {
  id           String               @id @default(cuid())
  proposalId   String
  proposal     StrategyProposal     @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  rank         Int
  sector       String
  /// The Extractor's key for the sector, when the target names one of its sectors.
  sectorKey    String?
  zones        String[]
  pains        String[]
  offerId      String?
  offer        Offer?               @relation(fields: [offerId], references: [id], onDelete: SetNull)
  /// Copied: the target stays readable if the offer is renamed or archived.
  offerName    String
  angle        String
  /// Each point with what it rests on: [{ text, basis: "crm" | "extractor" | "catalogue" | "hypothesis" }].
  rationale    Json
  campaignName String
  /// The search it suggests.
  activity     String
  location     String
  maxResults   Int
  /// Businesses the Extractor already knows for this sector and zone, when it said.
  knownCount   Int?
  status       StrategyTargetStatus @default(PROPOSED)
  campaignId   String?
  campaign     Campaign?            @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  searchId     String?
  search       ExtractionSearch?    @relation(fields: [searchId], references: [id], onDelete: SetNull)
  decidedById  String?
  decidedAt    DateTime?
  createdAt    DateTime             @default(now())

  @@unique([proposalId, rank])
}

/// Jev's reading of a fiche for its campaign: relevant, maybe or not, with its confidence. Above the high threshold it
/// orders the campaign's fiches; below, a person decides. Nothing else changes on the fiche without them.
model LeadRelevance {
  id          String            @id @default(cuid())
  workspaceId String
  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  leadId      String
  lead        Lead              @relation(fields: [leadId], references: [id], onDelete: Cascade)
  campaignId  String
  campaign    Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  /// The offer it was judged for, copied by name.
  offerName   String?
  runId       String?
  run         AgentRun?         @relation(fields: [runId], references: [id], onDelete: SetNull)
  /// Null when Jev declined to answer: a person decides.
  verdict     RelevanceVerdict?
  confidence  Float?
  outcome     TriageOutcome
  model       String
  /// What a person decided, when they did.
  decision    RelevanceVerdict?
  decidedById String?
  decidedAt   DateTime?
  createdAt   DateTime          @default(now())

  @@unique([leadId, campaignId])
  @@index([campaignId, outcome])
}

// E27: AI quality (docs/crm-v1/AGENTS-IA.md §20).

/// One evaluation: an agent measured on a set of cases, with one or more models standing in for one of its roles. The
/// run that does it carries its status and its cost; the results per model are written when it ends.
model AiEvaluation {
  id             String             @id @default(cuid())
  workspaceId    String
  workspace      Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// The suite (features/quality/suites.ts), named after the agent it measures.
  suite          String
  /// The role whose model the contenders replace in the agent's steps.
  role           String
  /// What is compared, the model in use first: Gateway model ids, plus "rules" (no model) where a suite has rules.
  contenders     String[]
  /// "reference": the frozen set of evals/; "team": cases the team labelled in the CRM.
  source         String
  /// The reference set's content hash, or the day the team's labels were read: only equal versions compare.
  datasetVersion String
  /// The cases measured, in order.
  caseIds        String[]
  /// The agent's layer (instructions, skills) when it was launched.
  agentVersion   Int                @default(0)
  /// The model that grades free answers (emails, pages), the same for every contender.
  judgeModel     String?
  estimateMicros Int
  /// Per contender: score, metrics, cost and duration (features/quality/metrics.ts). Null until the run ends.
  results        Json?
  runId          String?            @unique
  run            AgentRun?          @relation(fields: [runId], references: [id], onDelete: SetNull)
  requestedById  String?
  requestedBy    User?              @relation("EvaluationRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  createdAt      DateTime           @default(now())
  finishedAt     DateTime?
  cases          AiEvaluationCase[]

  @@index([workspaceId, suite, createdAt])
}

/// What one contender did on one case: right or not, its grade, what was expected and obtained, its cost and its time.
model AiEvaluationCase {
  id           String       @id @default(cuid())
  evaluationId String
  evaluation   AiEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  contender    String
  caseId       String
  ok           Boolean
  /// 0-1: the suite's grade of this answer.
  score        Float?
  /// Expected and obtained, bounded. For the team's own replies: labels only, never their text.
  detail       Json
  error        String?
  costMicros   Int          @default(0)
  /// What grading the answer cost (the judge), kept apart from the contender's own cost.
  judgeMicros  Int          @default(0)
  durationMs   Int          @default(0)
  createdAt    DateTime     @default(now())

  @@unique([evaluationId, contender, caseId])
}

/// E28: where a mission stands. PROPOSED waits for its click; RUNNING works or waits (a search, a run, a click);
/// PAUSED waits for the person (their pause, an incident, a higher cap).
enum AgentMissionStatus {
  PROPOSED
  REFUSED
  EXPIRED
  RUNNING
  PAUSED
  SUCCEEDED
  FAILED
  CANCELLED
}

enum AgentMissionStepStatus {
  PENDING
  RUNNING
  WAITING
  DONE
  SKIPPED
  FAILED
  /// Started by a worker that stopped before its end: maybe done, never redone without the person.
  UNCERTAIN
  CANCELLED
}

enum AgentMissionScheduleStatus {
  ACTIVE
  PAUSED
  STOPPED
}

/// E28: a plan of several actions the copilot proposed and a person launched in one click (features/missions/). The
/// worker carries it out step by step with the person's rights of the moment; the plan does not change once launched.
model AgentMission {
  id             String                @id @default(cuid())
  workspaceId    String
  workspace      Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// The person it acts for: each step checks this person's rights when it runs.
  requestedById  String?
  requestedBy    User?                 @relation("MissionRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  title          String
  status         AgentMissionStatus    @default(PROPOSED)
  /// The plan as checked: { title, steps: [{ id, action, input, forEach? }], recurrence? }, references unresolved.
  plan           Json
  /// What it should and could cost on AI when it was proposed (micro-euros).
  probableMicros Int                   @default(0)
  maxMicros      Int                   @default(0)
  /// Most it may spend on AI (D32): the workspace's cap, or more after a second confirmation.
  capMicros      Int                   @default(0)
  /// The copilot conversation it was proposed in: the proposal ends at the next question there.
  conversationId String?
  /// A proposal not launched by then expires.
  expiresAt      DateTime?
  approvedAt     DateTime?
  /// An occurrence of a recurring mission.
  scheduleId     String?
  schedule       AgentMissionSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  /// Why it paused or failed, in words for the person; a "budget" pause asks for a higher cap.
  pauseKind      String?
  pauseReason    String?
  /// What it did, composed in code at its end: counts, the tag on its fiches, links.
  report         Json?
  // The engine (features/missions/engine.ts): looked at again from wakeAt, by one worker at a time.
  wakeAt         DateTime?
  lockedBy       String?
  lockedUntil    DateTime?
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  steps AgentMissionStep[]
  runs  AgentRun[]

  @@index([workspaceId, createdAt])
  @@index([requestedById, createdAt])
  @@index([status, wakeAt])
  @@index([conversationId])
}

/// One unit of a mission's work: a step of its plan, or one item of a step that loops (forEach). Created when the
/// step can start, with its references resolved; claimed before it runs, so it runs at most once.
model AgentMissionStep {
  id         String                 @id @default(cuid())
  missionId  String
  mission    AgentMission           @relation(fields: [missionId], references: [id], onDelete: Cascade)
  /// The plan's step ("s1"…) and the item of its loop (0 without one).
  key        String
  item       Int                    @default(0)
  action     String
  /// The input as executed.
  input      Json
  status     AgentMissionStepStatus @default(PENDING)
  /// What it waits for once launched: "search", "run", "sort" or "approval", and its id.
  waitKind   String?
  waitId     String?
  /// What it did, for the card and the report.
  output     Json?
  /// What a later step may cite ({ searchId, leadIds… }), once it is over.
  exports    Json?
  error      String?
  attempts   Int                    @default(0)
  notBefore  DateTime?
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  @@unique([missionId, key, item])
  @@index([waitKind, waitId])
}

/// E28 (D35): a mission that comes back. Each occurrence runs the frozen plan with the rights and caps of its day.
model AgentMissionSchedule {
  id            String                     @id @default(cuid())
  workspaceId   String
  workspace     Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  requestedById String?
  requestedBy   User?                      @relation("MissionScheduleRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  title         String
  plan          Json
  /// { frequency: "daily" | "weekly", days, hour, minute }, Europe/Paris time.
  recurrence    Json
  capMicros     Int
  status        AgentMissionScheduleStatus @default(ACTIVE)
  nextRunAt     DateTime?
  /// Occurrences failed in a row: two pause it.
  failures      Int                        @default(0)
  pauseReason   String?
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt

  missions AgentMission[]

  @@index([status, nextRunAt])
  @@index([requestedById])
}
