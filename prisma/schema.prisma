generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String                @id @default(cuid())
  name                 String?
  email                String?               @unique
  emailVerified        DateTime?
  image                String?
  password             String?
  role                 Role                  @default(USER)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  phone                String?
  language             String?               @default("fr")
  ip                   String?
  isTemporaryPassword  Boolean               @default(false)
  favorite             Boolean               @default(false)
  /// A deactivated member can no longer sign in; history stays attached to the account.
  active               Boolean               @default(true)
  lastLoginAt          DateTime?
  auditLogs            AuditLog[]
  invitationsSent      Invitation[]
  accounts             Account[]
  appointments         Appointment[]
  articles             Article[]
  articleSchedules     ArticleSchedule[]
  availabilities       Availability[]
  breakTime            BreakTime?
  comments             Comment[]
  companies            Company[]
  documents            Document[]
  exceptions           Exception[]
  notifications        Notification[]
  notificationSettings NotificationSettings?
  sessions             Session[]
  settings             Settings?
  sharedDocuments      SharedDocument[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Appointment {
  id         String            @id @default(cuid())
  clientName String
  email      String
  phone      String
  date       DateTime
  status     AppointmentStatus @default(PENDING)
  type       AppointmentType
  notes      String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  userId     String
  ip         String?
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Availability {
  id        String   @id @default(cuid())
  dayOfWeek Int
  startTime String
  endTime   String
  isActive  Boolean  @default(true)
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dayOfWeek])
}

model BreakTime {
  id        String   @id @default(cuid())
  startTime String
  endTime   String
  isActive  Boolean  @default(true)
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Exception {
  id          String   @id @default(cuid())
  date        DateTime
  isAvailable Boolean  @default(false)
  reason      String?
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model Document {
  id            String         @id @default(cuid())
  type          DocumentType
  number        String
  date          DateTime
  dueDate       DateTime?
  status        DocumentStatus @default(DRAFT)
  clientName    String
  clientEmail   String
  clientPhone   String?
  clientAddress String?
  clientCity    String?
  subtotal      Float
  taxType       String
  taxValue      Float
  tax           Float
  total         Float
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  userId        String
  companyId     String?
  company       Company?       @relation(fields: [companyId], references: [id])
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items         DocumentItem[]
}

model DocumentItem {
  id          String   @id @default(cuid())
  description String
  quantity    Int
  price       Float
  total       Float
  details     String?
  documentId  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

model Company {
  id         String     @id @default(cuid())
  name       String
  address    String
  city       String
  email      String
  phone      String
  siret      String?
  tva        String?
  website    String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  userId     String
  country    String?
  postalCode String?
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents  Document[]
  rib        Rib?
}

model Rib {
  id        String   @id @default(cuid())
  bank      String
  iban      String
  bic       String
  companyId String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model NotificationSettings {
  id                       String   @id @default(cuid())
  userId                   String   @unique
  email                    Boolean  @default(true)
  push                     Boolean  @default(true)
  appointments             Boolean  @default(true)
  appointmentReminders     Boolean  @default(true)
  appointmentChanges       Boolean  @default(true)
  appointmentCancellations Boolean  @default(true)
  newMessages              Boolean  @default(true)
  contactForm              Boolean  @default(true)
  systemUpdates            Boolean  @default(true)
  securityAlerts           Boolean  @default(true)
  newsletters              Boolean  @default(false)
  specialOffers            Boolean  @default(false)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  openaiApiKey             String?
  openaiModel              String   @default("GPT35")
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SharedDocument {
  id          String             @id @default(cuid())
  name        String
  type        SharedDocumentType
  url         String
  description String?
  size        Int
  mimeType    String
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  userId      String
  isShared    Boolean            @default(false)
  sharedBy    SharedBy           @default(USER)
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  articles  Article[]
}

model Tag {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  articles  Article[] @relation("ArticleToTag")
}

model Theme {
  id          String    @id @default(cuid())
  name        String
  description String
  type        String    @default("BLOG")
  colors      Json
  features    String[]
  layout      String
  isDefault   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  articles    Article[]
}

model Article {
  id              String    @id @default(cuid())
  title           String
  slug            String    @unique
  content         String
  excerpt         String?
  coverImage      String?
  status          String    @default("DRAFT")
  publishedAt     DateTime?
  metaTitle       String?
  metaDescription String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  userId          String
  views           Int       @default(0)
  categoryId      String?
  themeId         String?
  category        Category? @relation(fields: [categoryId], references: [id])
  theme           Theme?    @relation(fields: [themeId], references: [id])
  user            User      @relation(fields: [userId], references: [id])
  comments        Comment[]
  tags            Tag[]     @relation("ArticleToTag")

  @@index([userId])
  @@index([themeId])
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  articleId String
  userId    String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([articleId])
  @@index([userId])
}

model Settings {
  id                      String   @id @default(cuid())
  userId                  String   @unique
  openaiApiKey            String?
  openaiModel             String   @default("GPT35")
  autoGenerateTags        Boolean  @default(false)
  autoOptimizeSEO         Boolean  @default(false)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  huggingFaceApiKey       String?
  imageProvider           String   @default("picsum")
  pexelsApiKey            String?
  stableDiffusionApiKey   String?
  huggingFaceModel        String?
  huggingFaceTextModel    String?
  replicateApiKey         String?
  replicateModel          String?
  textProvider            String   @default("openai")
  allowRsslessGeneration  Boolean  @default(false)
  defaultRssCategory      String   @default("technology")
  highQualityGeneration   Boolean  @default(false)
  rssArticleSelectionMode String   @default("recent")
  rssSourceCount          Int      @default(3)
  validatedRssFeeds       String?
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ArticleSchedule {
  id                      String            @id @default(cuid())
  name                    String
  userId                  String
  frequency               ScheduleFrequency @default(WEEKLY)
  status                  ScheduleStatus    @default(ACTIVE)
  categories              String[]
  keywords                String[]
  textProvider            String?
  openaiModel             String?
  huggingFaceModel        String?
  newsQuery               String?
  nextRunDate             DateTime
  lastRunDate             DateTime?
  lastRunStatus           String?
  tone                    String            @default("professionnel")
  language                String            @default("français")
  publishImmediately      Boolean           @default(false)
  maxArticlesPerMonth     Int               @default(4)
  articlesGenerated       Int               @default(0)
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  generateImage           Boolean           @default(false)
  imageModel              String?
  imageProvider           String?
  category                String?
  contentSource           String            @default("rss")
  highQualityGeneration   Boolean           @default(false)
  rssArticleSelectionMode String            @default("recent")
  rssSourceCount          Int               @default(3)
  user                    User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([nextRunDate])
  @@index([status])
}

enum Role {
  // Legacy: USER = former appointment "client" (becomes a Contact in E3), ADMIN = migrated to OWNER.
  USER
  ADMIN
  // CRM staff roles (docs/crm-v1/PLAN.md section 4).
  OWNER
  MANAGER
  SDR
  CLOSER
  VIEWER
}

enum AuditActorKind {
  USER
  AGENT
  SYSTEM
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum AppointmentType {
  LANDING_PAGE
  ECOMMERCE
  SAAS
  OTHER
  CONSULTATION
  SUIVI
  URGENCE
}

enum DocumentStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  ACCEPTED
  REJECTED
}

enum DocumentType {
  INVOICE
  QUOTE
}

enum SharedDocumentType {
  FILE
  IMAGE
  PDF
  OTHER
}

enum SharedBy {
  ADMIN
  USER
}

enum ScheduleStatus {
  ACTIVE
  PAUSED
  COMPLETED
  FAILED
}

enum ScheduleFrequency {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
}

/// One-time link that gives a person access to the CRM with a given role. Only the SHA-256 of the token is stored.
model Invitation {
  id          String    @id @default(cuid())
  email       String
  role        Role
  tokenHash   String    @unique
  invitedById String
  invitedBy   User      @relation(fields: [invitedById], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([email])
}

/// Who did what, when. Written by people, agents and the system; never updated.
model AuditLog {
  id         String         @id @default(cuid())
  actorId    String?
  actor      User?          @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorKind  AuditActorKind @default(USER)
  action     String
  entityType String?
  entityId   String?
  /// Email or other identifier the action is about when there is no entity (failed sign-in, invitation).
  subject    String?
  metadata   Json?
  ip         String?
  createdAt  DateTime       @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@index([action, subject, createdAt])
}
