  generateImage           Boolean           @default(false)
  imageModel              String?
  imageProvider           String?
  category                String?
  contentSource           String            @default("rss")
  highQualityGeneration   Boolean           @default(false)
  rssArticleSelectionMode String            @default("recent")
  rssSourceCount          Int               @default(3)
  user                    User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([nextRunDate])
  @@index([status])
