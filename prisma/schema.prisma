generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String                  @id @default(cuid())
  name                   String?
  email                  String?                 @unique
  emailVerified          DateTime?
  image                  String?
  password               String?
  role                   Role                    @default(USER)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  phone                  String?
  language               String?                 @default("fr")
  ip                     String?
  isTemporaryPassword    Boolean                 @default(false)
  favorite               Boolean                 @default(false)
  /// A deactivated member can no longer sign in; history stays attached to the account.
  active                 Boolean                 @default(true)
  lastLoginAt            DateTime?
  auditLogs              AuditLog[]
  invitationsSent        Invitation[]
  workspaceId            String?
  workspace              Workspace?              @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  ownedLeads             Lead[]                  @relation("LeadOwner")
  ownedDeals             Deal[]                  @relation("DealOwner")
  assignedTasks          Task[]                  @relation("TaskAssignee")
  createdTasks           Task[]                  @relation("TaskCreator")
  activities             Activity[]
  hostedMeetings         Meeting[]               @relation("MeetingHost")
  createdMeetings        Meeting[]               @relation("MeetingCreator")
  availabilityRules      AvailabilityRule[]
  availabilityExceptions AvailabilityException[]
  bookingProfile         BookingProfile?
  importBatches          ImportBatch[]
  savedViews             SavedView[]
  accounts               Account[]
  appointments           Appointment[]
  articles               Article[]
  articleSchedules       ArticleSchedule[]
  availabilities         Availability[]
  breakTime              BreakTime?
  comments               Comment[]
  billingCompanies       BillingCompany[]
  documents              Document[]
  exceptions             Exception[]
  notifications          Notification[]
  notificationSettings   NotificationSettings?
  sessions               Session[]
  settings               Settings?
  sharedDocuments        SharedDocument[]
  ExtractionSearch       ExtractionSearch[]
  mailboxes              Mailbox[]               @relation("MailboxOwner")
  sequencesCreated       Sequence[]              @relation("SequenceCreator")
  enrollmentsCreated     SequenceEnrollment[]    @relation("EnrollmentCreator")
  emailTemplates         EmailTemplate[]
  sentEmails             EmailMessage[]          @relation("EmailSender")
  /// E16: the character this member appears as in the 3D view (see features/hq/characters.ts); null = chosen from the role.
  hqCharacter            String?
  campaignsOwned         Campaign[]              @relation("CampaignOwner")
  campaignsCreated       Campaign[]              @relation("CampaignCreator")
  /// E17: AI runs the member asked for, and the approvals they requested or decided.
  agentRuns              AgentRun[]              @relation("AgentRunRequester")
  approvalsRequested     AgentApproval[]         @relation("ApprovalRequester")
  approvalsDecided       AgentApproval[]         @relation("ApprovalDecider")
}

/// LEGACY (blog, AI keys, NextAuth adapter): unused, dropped by prisma/pending/drop-legacy-blog.sql once a dump is taken.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

/// LEGACY (blog, AI keys, NextAuth adapter): unused, dropped by prisma/pending/drop-legacy-blog.sql once a dump is taken.
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// LEGACY (blog, AI keys, NextAuth adapter): unused, dropped by prisma/pending/drop-legacy-blog.sql once a dump is taken.
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Appointment {
  id         String            @id @default(cuid())
  clientName String
  email      String
  phone      String
  date       DateTime
  status     AppointmentStatus @default(PENDING)
  type       AppointmentType
  notes      String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  userId     String
  ip         String?
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Availability {
  id        String   @id @default(cuid())
  dayOfWeek Int
  startTime String
  endTime   String
  isActive  Boolean  @default(true)
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dayOfWeek])
}

model BreakTime {
  id        String   @id @default(cuid())
  startTime String
  endTime   String
  isActive  Boolean  @default(true)
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Exception {
  id          String   @id @default(cuid())
  date        DateTime
  isAvailable Boolean  @default(false)
  reason      String?
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model Document {
  id            String          @id @default(cuid())
  type          DocumentType
  number        String
  date          DateTime
  dueDate       DateTime?
  status        DocumentStatus  @default(DRAFT)
  clientName    String
  clientEmail   String
  clientPhone   String?
  clientAddress String?
  clientCity    String?
  subtotal      Float
  taxType       String
  taxValue      Float
  tax           Float
  total         Float
  notes         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  userId        String
  companyId     String?
  company       BillingCompany? @relation(fields: [companyId], references: [id])
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items         DocumentItem[]
}

model DocumentItem {
  id          String   @id @default(cuid())
  description String
  quantity    Int
  price       Float
  total       Float
  details     String?
  documentId  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

/// Legal entity of the agency used on quotes and invoices (parked until the billing module returns). Was "Company".
model BillingCompany {
  id         String     @id @default(cuid())
  name       String
  address    String
  city       String
  email      String
  phone      String
  siret      String?
  tva        String?
  website    String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  userId     String
  country    String?
  postalCode String?
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents  Document[]
  rib        Rib?
}

model Rib {
  id        String         @id @default(cuid())
  bank      String
  iban      String
  bic       String
  companyId String         @unique
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  company   BillingCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model NotificationSettings {
  id                       String   @id @default(cuid())
  userId                   String   @unique
  email                    Boolean  @default(true)
  push                     Boolean  @default(true)
  appointments             Boolean  @default(true)
  appointmentReminders     Boolean  @default(true)
  appointmentChanges       Boolean  @default(true)
  appointmentCancellations Boolean  @default(true)
  newMessages              Boolean  @default(true)
  contactForm              Boolean  @default(true)
  systemUpdates            Boolean  @default(true)
  securityAlerts           Boolean  @default(true)
  newsletters              Boolean  @default(false)
  specialOffers            Boolean  @default(false)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  openaiApiKey             String?
  openaiModel              String   @default("GPT35")
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// PARKED: files shared with former clients; kept until a retention decision is made.
model SharedDocument {
  id          String             @id @default(cuid())
  name        String
  type        SharedDocumentType
  url         String
  description String?
  size        Int
  mimeType    String
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  userId      String
  isShared    Boolean            @default(false)
  sharedBy    SharedBy           @default(USER)
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// LEGACY (blog, AI keys, NextAuth adapter): unused, dropped by prisma/pending/drop-legacy-blog.sql once a dump is taken.
model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  articles  Article[]
}

/// LEGACY (blog, AI keys, NextAuth adapter): unused, dropped by prisma/pending/drop-legacy-blog.sql once a dump is taken.
model Tag {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  articles  Article[] @relation("ArticleToTag")
}

/// LEGACY (blog, AI keys, NextAuth adapter): unused, dropped by prisma/pending/drop-legacy-blog.sql once a dump is taken.
model Theme {
  id          String    @id @default(cuid())
  name        String
  description String
  type        String    @default("BLOG")
  colors      Json
  features    String[]
  layout      String
  isDefault   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  articles    Article[]
}

/// LEGACY (blog, AI keys, NextAuth adapter): unused, dropped by prisma/pending/drop-legacy-blog.sql once a dump is taken.
model Article {
  id              String    @id @default(cuid())
  title           String
  slug            String    @unique
  content         String
  excerpt         String?
  coverImage      String?
  status          String    @default("DRAFT")
  publishedAt     DateTime?
  metaTitle       String?
  metaDescription String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  userId          String
  views           Int       @default(0)
  categoryId      String?
  themeId         String?
  category        Category? @relation(fields: [categoryId], references: [id])
  theme           Theme?    @relation(fields: [themeId], references: [id])
  user            User      @relation(fields: [userId], references: [id])
  comments        Comment[]
  tags            Tag[]     @relation("ArticleToTag")

  @@index([userId])
  @@index([themeId])
}

/// LEGACY (blog, AI keys, NextAuth adapter): unused, dropped by prisma/pending/drop-legacy-blog.sql once a dump is taken.
model Comment {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  articleId String
  userId    String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([articleId])
  @@index([userId])
}

